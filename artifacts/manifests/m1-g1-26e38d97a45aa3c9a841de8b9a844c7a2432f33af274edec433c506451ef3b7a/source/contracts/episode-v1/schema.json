        "requests": {
          "type": "object",
          "properties": {
            "p1": {
              "type": "object",
              "properties": {
                "request_id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "request_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                },
                "protocol_length": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "request_id",
                "request_hash",
                "protocol_length"
