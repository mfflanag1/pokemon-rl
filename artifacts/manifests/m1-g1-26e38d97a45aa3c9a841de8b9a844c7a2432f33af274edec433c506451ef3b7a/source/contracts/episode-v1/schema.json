          },
          "data": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "data"
        ],
        "additionalProperties": false
      }
    },
    "raw_output_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  },
  "required": [
    "episode",
    "raw_output",
    "raw_output_hash"
