      "type": "object",
      "properties": {
        "group": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "event": {
          "enum": [
            "initial",
            "awaiting_choice",
            "resolved",
            "rerequest",
            "terminal"
          ]
        },
        "turn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "phase": {
          "enum": [
            "joint_move",
            "single_replacement",
            "double_replacement",
            "switch_continuation",
            "revival",
            "mixed_switch",
            "terminal"
          ]
        },
        "side_phases": {
          "type": "object",
          "properties": {
            "p1": {
              "enum": [
                "move",
                "wait",
                "faint_replacement",
                "switch_continuation",
                "revival",
                "terminal"
              ]
            },
            "p2": {
              "enum": [
                "move",
                "wait",
                "faint_replacement",
                "switch_continuation",
                "revival",
                "terminal"
