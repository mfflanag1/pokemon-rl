      "type": "object",
      "properties": {
        "viewer": {
          "enum": [
            "p1",
            "p2"
          ]
        },
        "request_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "turn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "phase": {
          "enum": [
            "move",
            "switch",
            "wait"
          ]
        },
        "request": {
          "$ref": "https://pokemon-reference.local/contracts/battle-v1/schema.json#/$defs/request"
        },
        "protocol_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "protocol_end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "protocol_delta": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protocol_prefix_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "admissible_actions": {
          "type": "array",
          "items": {
            "$ref": "https://pokemon-reference.local/contracts/battle-v1/schema.json#/$defs/action"
          }
        },
        "action_mask": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 14,
          "maxItems": 14
        },
        "view_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "viewer",
        "request_id",
        "turn",
        "phase",
        "request",
        "protocol_start",
        "protocol_end",
        "protocol_delta",
        "protocol_prefix_hash",
        "admissible_actions",
        "action_mask",
        "view_id"
