          "maxItems": 2,
          "uniqueItems": true
        },
        "commitments": {
          "type": "object",
          "properties": {
            "p1": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "p2": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "p1",
            "p2"
          ],
          "additionalProperties": false
