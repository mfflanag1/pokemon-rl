            ],
            "additionalProperties": false
          }
        },
        "sides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "enum": [
                  "p1",
                  "p2"
                ]
              },
              "pokemon_left": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
