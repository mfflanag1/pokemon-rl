{
  "name": "pokemon-reference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "node scripts/bootstrap.mjs",
    "reference": "node packages/reference-node/cli.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/test.mjs",
    "contract": "node packages/battle-contract/cli.mjs",
    "contract:fixtures": "node scripts/contract-fixtures.mjs",
    "contract:smoke": "node scripts/contract-smoke.mjs",
    "corpus": "node packages/corpus/cli.mjs",
    "episodes": "node packages/episodes/cli.mjs",
    "features:catalog": "node scripts/player-feature-catalog.mjs",
    "features:fixtures": "node scripts/player-feature-fixtures.mjs",
    "mechanics:setup": "npm ci --prefix tools/mechanics-deps --ignore-scripts --no-audit --no-fund",
    "mechanics": "node scripts/mechanics-inventory.mjs",
    "dataset:collect": "node packages/dataset/collect.mjs",
    "learner:canaries": "PYTHONPATH=python .venv/bin/python -m pokemon_learner.canaries",
    "slice:reference": "node packages/slice/reference.mjs",
    "jax:reference": "node packages/jax-slice/reference.mjs",
    "jax:campaign": "PYTHONPATH=python .venv/bin/python -m pokemon_jax.campaign",
    "jax:learner": "PYTHONPATH=python .venv/bin/python -m pokemon_jax_learner.campaign",
    "jax:fixed-loop": "PYTHONPATH=python .venv/bin/python -m pokemon_fixed.campaign",
    "jax:binary-policy": "PYTHONPATH=python .venv/bin/python -m pokemon_binary.qualification",
    "showdown:words": "node packages/showdown-chance/word-oracle.mjs",
    "showdown:reference": "node packages/showdown-chance/reference.mjs",
    "jax:showdown-chance": "PYTHONPATH=python .venv/bin/python -m pokemon_showdown.campaign",
    "jax:policy-soak": "PYTHONPATH=python .venv/bin/python -m pokemon_soak.campaign",
    "jax:policy-pilot": "PYTHONPATH=python .venv/bin/python -m pokemon_pilot.campaign",
    "reference:switch": "PYTHONPATH=python .venv/bin/python -m pokemon_switch.campaign",
    "bot": "node packages/showdown-bot/cli.mjs",
    "bot:server": "node packages/showdown-bot/local-server.mjs",
    "bot:benchmark": "node packages/showdown-bot/campaign.mjs",
    "bot:audit": "node packages/showdown-bot/audit.mjs",
    "bot:network-smoke": "node packages/showdown-bot/network-smoke.mjs",
    "bot:recover": "node packages/showdown-session/cli.mjs",
    "bot:recovery-smoke": "node packages/showdown-session/network.mjs",
    "bot:recovery-audit": "node packages/showdown-session/audit.mjs",
    "bot:panel": "node packages/showdown-panel/campaign.mjs",
    "bot:panel-audit": "node packages/showdown-panel/audit.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1"
  }
}
