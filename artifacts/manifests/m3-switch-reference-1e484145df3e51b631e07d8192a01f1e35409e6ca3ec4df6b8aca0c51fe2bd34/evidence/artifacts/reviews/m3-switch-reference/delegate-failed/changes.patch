+    def test_malformed_pp(self):
+        slot = lambda r: r["active"][0]["moves"][0]  # noqa: E731
+        cases = {
+            "bool pp": lambda r: slot(r).update(pp=True),
+            "string pp": lambda r: slot(r).update(pp="35"),
+            "negative pp": lambda r: slot(r).update(pp=-1),
+            "pp above max": lambda r: slot(r).update(pp=36),
