new file mode 100644
index 0000000..6ac006f
--- /dev/null
+++ b/python/pokemon_switch/contract.py
@@ -0,0 +1,478 @@
+"""Independent four-action codec for the switch-reference-1 scope.
+
+Standard library only. The codec consumes one side's stock Showdown private
+request and produces either a four-boolean legality mask or a Showdown choice
+string. It knows nothing about the opponent, request ids, or submission; those
+belong to the caller. Zero-based action indices follow contracts/switch-v1:
+
+    0 / 1 -> the active request's first / second move      ("move 1" / "move 2")
+    2 / 3 -> switch to original member A / B               ("switch <position>")
+
+Original members are located by exact own ident suffix (``"p1: A"``), never by
+list position, because Showdown reorders ``side.pokemon`` after a switch. The
+switch command carries that member's *current* 1-based request position.
+"""
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+__all__ = [
+    "ACTION_COUNT",
+    "Codec",
+    "ContractError",
+    "Decoded",
+    "IllegalActionError",
+    "Member",
+    "PROFILE_PATH",
+    "Profile",
+    "SpeciesSet",
+    "VERSION",
+    "command",
+    "decode",
+    "load_profile",
+    "mask",
+    "parse_profile",
+    "to_id",
+]
+
+VERSION = "switch-reference-1"
+ACTION_COUNT = 4
+EXPECTED_NAMES: Tuple[str, str] = ("A", "B")
+EXPECTED_ACTIONS: Tuple[str, str, str, str] = (
+    "move-slot-1",
+    "move-slot-2",
+    "switch-original-A",
+    "switch-original-B",
+)
+SIDE_IDS = ("p1", "p2")
+PROFILE_PATH = (
+    Path(__file__).resolve().parents[2] / "contracts" / "switch-v1" / "profile.json"
+)
+
+# Active-slot flags that signal mechanics the reference scope excludes.
+_FORBIDDEN_ACTIVE_FLAGS = (
+    "canTerastallize",
+    "trapped",
+    "maybeTrapped",
+    "maybeDisabled",
+    "canDynamax",
+    "canMegaEvo",
+    "canMegaEvoX",
+    "canMegaEvoY",
+    "canUltraBurst",
+    "canZMove",
+)
+# Per-pokemon flags that signal excluded mechanics when truthy.
+_FORBIDDEN_POKEMON_FLAGS = ("reviving", "commanding", "terastallized")
+# Top-level request keys that only appear in excluded request types.
+_FORBIDDEN_REQUEST_KEYS = ("teamPreview", "maxChosenTeamSize")
+
+_CONDITION_RE = re.compile(r"^(\d+)/(\d+)(?: [a-z]{3})?$")
+_FAINTED_RE = re.compile(r"^0 fnt$")
+_NON_ID_RE = re.compile(r"[^a-z0-9]")
+
+
+class ContractError(ValueError):
+    """The request, index, or profile is malformed or outside the admitted scope."""
+
+
+class IllegalActionError(ContractError):
+    """The index is well-formed but names an action that is not legal right now."""
+
+
+def to_id(text: Any) -> str:
+    """Showdown ``toID``: lowercase and strip everything but ``[a-z0-9]``."""
+    if not isinstance(text, str):
+        raise ContractError(f"expected a string to normalise, got {type(text).__name__}")
+    return _NON_ID_RE.sub("", text.lower())
+
+
+# --------------------------------------------------------------------------- #
+# Profile
+# --------------------------------------------------------------------------- #
+
+
+@dataclass(frozen=True)
+class SpeciesSet:
+    """One admitted set: species id/name and its two move ids in declared order."""
+
+    id: str
+    species: str
+    moves: Tuple[str, str]
+
+
+@dataclass(frozen=True)
+class Profile:
+    version: str
+    level: int
+    gender: str
+    names: Tuple[str, str]
+    actions: Tuple[str, str, str, str]
+    species: Mapping[str, SpeciesSet]  # keyed by species id
+
+    def details_for(self, species_id: str) -> str:
+        """The exact Showdown ``details`` string an admitted member must carry."""
+        return f"{self.species[species_id].species}, L{self.level}, {self.gender}"
+
+
+def parse_profile(raw: Any) -> Profile:
+    """Validate the parts of profile.json this codec depends on."""
+    raw = _expect_mapping(raw, "profile")
+    if raw.get("version") != VERSION:
+        raise ContractError(f"profile version must be {VERSION!r}")
+    if raw.get("team_size") != 2:
+        raise ContractError("profile team_size must be 2")
+    names = raw.get("names")
+    if not (isinstance(names, list) and tuple(names) == EXPECTED_NAMES):
+        raise ContractError(f"profile names must be {list(EXPECTED_NAMES)}")
+    actions = raw.get("actions")
+    if not (isinstance(actions, list) and tuple(actions) == EXPECTED_ACTIONS):
+        raise ContractError(f"profile actions must be {list(EXPECTED_ACTIONS)}")
+    level = raw.get("level")
+    if type(level) is not int or level < 1 or level > 100:
+        raise ContractError("profile level must be an int in 1..100")
+    gender = raw.get("gender")
+    if gender not in ("M", "F", "N"):
+        raise ContractError("profile gender must be one of M/F/N")
+
+    species_raw = raw.get("species")
+    if not isinstance(species_raw, list) or not species_raw:
+        raise ContractError("profile species must be a non-empty list")
+    species: dict[str, SpeciesSet] = {}
+    for entry in species_raw:
+        entry = _expect_mapping(entry, "profile species entry")
+        sid = entry.get("id")
+        name = entry.get("species")
+        moves = entry.get("moves")
+        if not isinstance(sid, str) or not isinstance(name, str) or to_id(name) != sid:
+            raise ContractError(f"profile species id/name mismatch: {entry!r}")
+        if not (isinstance(moves, list) and len(moves) == 2 and all(isinstance(m, str) for m in moves)):
+            raise ContractError(f"profile species {sid!r} must declare exactly two moves")
+        move_ids = (to_id(moves[0]), to_id(moves[1]))
+        if move_ids[0] == move_ids[1] or "struggle" in move_ids:
+            raise ContractError(f"profile species {sid!r} has invalid moves {moves!r}")
+        if sid in species:
+            raise ContractError(f"profile species {sid!r} declared twice")
+        species[sid] = SpeciesSet(id=sid, species=name, moves=move_ids)
+
+    return Profile(
+        version=VERSION,
+        level=level,
+        gender=gender,
+        names=EXPECTED_NAMES,
+        actions=EXPECTED_ACTIONS,
+        species=species,
+    )
+
+
+def load_profile(path: Optional[Path] = None) -> Profile:
+    with open(path or PROFILE_PATH, encoding="utf-8") as handle:
+        return parse_profile(json.load(handle))
+
+
+# --------------------------------------------------------------------------- #
+# Decoded request
+# --------------------------------------------------------------------------- #
+
+
+@dataclass(frozen=True)
+class Member:
+    """One own team member as seen in the current request."""
+
+    name: str  # original name, "A" or "B"
+    position: int  # current 1-based position in side.pokemon
+    species: SpeciesSet
+    active: bool
+    fainted: bool
+
+    @property
+    def switchable(self) -> bool:
+        return not self.active and not self.fainted
+
+
+@dataclass(frozen=True)
+class Decoded:
+    kind: str  # "wait" | "move" | "switch"
+    side: Optional[str]  # "p1" / "p2"; None only for a bare wait request
+    members: Tuple[Member, ...]  # ordered by original name (A, B); empty for bare wait
+    mask: Tuple[bool, bool, bool, bool]
+
+    def member(self, name: str) -> Member:
+        for member in self.members:
+            if member.name == name:
+                return member
+        raise ContractError(f"no member named {name!r} in decoded request")
+
+
+# --------------------------------------------------------------------------- #
+# Low-level shape checks
+# --------------------------------------------------------------------------- #
+
+
+def _expect_mapping(value: Any, what: str) -> Mapping[str, Any]:
+    if not isinstance(value, Mapping):
+        raise ContractError(f"{what} must be an object, got {type(value).__name__}")
+    return value
+
+
+def _expect_list(value: Any, what: str) -> Sequence[Any]:
+    if not isinstance(value, list):
+        raise ContractError(f"{what} must be a list, got {type(value).__name__}")
+    return value
+
+
+def _expect_bool(value: Any, what: str) -> bool:
+    if type(value) is not bool:
+        raise ContractError(f"{what} must be a boolean, got {value!r}")
+    return value
+
+
+def _expect_int(value: Any, what: str) -> int:
+    # bool is a subclass of int; a boolean PP is malformed, not zero/one.
+    if type(value) is not int:
+        raise ContractError(f"{what} must be an integer, got {value!r}")
+    return value
+
+
+def _expect_str(value: Any, what: str) -> str:
+    if not isinstance(value, str):
+        raise ContractError(f"{what} must be a string, got {value!r}")
+    return value
+
+
+# --------------------------------------------------------------------------- #
+# Side parsing
+# --------------------------------------------------------------------------- #
+
+
+def _parse_condition(text: Any) -> bool:
+    """Return whether the member is fainted; reject anything but stock HP text."""
+    text = _expect_str(text, "pokemon condition")
+    if _FAINTED_RE.match(text):
+        return True
+    match = _CONDITION_RE.match(text)
+    if not match:
+        raise ContractError(f"unrecognised condition {text!r}")
+    hp, max_hp = int(match.group(1)), int(match.group(2))
+    if max_hp <= 0 or hp <= 0 or hp > max_hp:
+        raise ContractError(f"inconsistent condition {text!r}")
+    return False
+
+
+def _parse_details(text: Any, profile: Profile) -> SpeciesSet:
+    text = _expect_str(text, "pokemon details")
+    parts = text.split(", ")
+    species = profile.species.get(to_id(parts[0]))
+    if species is None:
+        raise ContractError(f"species {parts[0]!r} is not in the admitted profile")
+    if parts[1:] != [f"L{profile.level}", profile.gender]:
+        raise ContractError(
+            f"details {text!r} must be exactly {profile.details_for(species.id)!r}"
+        )
+    return species
+
+
+def _parse_pokemon(entry: Any, position: int, side_id: str, profile: Profile) -> Member:
+    entry = _expect_mapping(entry, f"side.pokemon[{position - 1}]")
+    ident = _expect_str(entry.get("ident"), "pokemon ident")
+    prefix = f"{side_id}: "
+    if not ident.startswith(prefix):
+        raise ContractError(f"ident {ident!r} does not belong to side {side_id!r}")
+    name = ident[len(prefix):]
+    if name not in profile.names:
+        raise ContractError(f"ident {ident!r} is not an original member name")
+
+    species = _parse_details(entry.get("details"), profile)
+    fainted = _parse_condition(entry.get("condition"))
+    active = _expect_bool(entry.get("active"), f"{ident} active flag")
+
+    for flag in _FORBIDDEN_POKEMON_FLAGS:
+        if entry.get(flag):
+            raise ContractError(f"{ident} carries out-of-scope flag {flag!r}")
+    if "item" in entry and entry["item"] not in ("", None):
+        raise ContractError(f"{ident} holds an item, which the profile excludes")
+    if "moves" in entry:
+        moves = _expect_list(entry["moves"], f"{ident} moves")
+        if tuple(moves) != species.moves:
+            raise ContractError(
+                f"{ident} move set {moves!r} is not the admitted set {list(species.moves)!r}"
+            )
+
+    return Member(name=name, position=position, species=species, active=active, fainted=fainted)
+
+
+def _parse_side(side: Any, profile: Profile) -> Tuple[str, Tuple[Member, Member]]:
+    side = _expect_mapping(side, "side")
+    side_id = side.get("id")
+    if side_id not in SIDE_IDS:
+        raise ContractError(f"side.id must be one of {SIDE_IDS}, got {side_id!r}")
+    pokemon = _expect_list(side.get("pokemon"), "side.pokemon")
+    if len(pokemon) != 2:
+        raise ContractError(f"side must list exactly two pokemon, got {len(pokemon)}")
+
+    members = [
+        _parse_pokemon(entry, index + 1, side_id, profile) for index, entry in enumerate(pokemon)
+    ]
+    names = [member.name for member in members]
+    if sorted(names) != sorted(profile.names):
+        raise ContractError(f"side must contain exactly one each of {profile.names}, got {names}")
+    if members[0].species.id == members[1].species.id:
+        raise ContractError("duplicate species are excluded by the profile")
+    if sum(member.active for member in members) != 1:
+        raise ContractError("exactly one own pokemon must be active")
+
+    by_name = {member.name: member for member in members}
+    return side_id, (by_name[profile.names[0]], by_name[profile.names[1]])
+
+
+# --------------------------------------------------------------------------- #
+# Active slot parsing
+# --------------------------------------------------------------------------- #
+
+
+def _parse_active(active: Any, member: Member) -> Tuple[bool, bool]:
+    """Return per-move legality for the single active slot."""
+    active = _expect_list(active, "active")
+    if len(active) != 1:
+        raise ContractError(f"singles request must have exactly one active slot, got {len(active)}")
+    slot = _expect_mapping(active[0], "active[0]")
+
+    for flag in _FORBIDDEN_ACTIVE_FLAGS:
+        if slot.get(flag):
+            raise ContractError(f"active slot carries out-of-scope flag {flag!r}")
+
+    moves = _expect_list(slot.get("moves"), "active[0].moves")
+    if len(moves) != 2:
+        raise ContractError(f"active slot must offer exactly two moves, got {len(moves)}")
+
+    legal = []
+    for index, raw in enumerate(moves):
+        raw = _expect_mapping(raw, f"active[0].moves[{index}]")
+        move_id = _expect_str(raw.get("id"), f"move {index + 1} id")
+        if move_id == "struggle":
+            raise ContractError("Struggle is excluded from the reference scope")
+        expected = member.species.moves[index]
+        if move_id != expected:
+            raise ContractError(
+                f"move {index + 1} is {move_id!r}; {member.species.species} must offer {expected!r}"
+            )
+        if "move" in raw and to_id(raw["move"]) != move_id:
+            raise ContractError(f"move {index + 1} display name {raw['move']!r} does not match {move_id!r}")
+
+        pp = _expect_int(raw.get("pp"), f"move {index + 1} pp")
+        maxpp = _expect_int(raw.get("maxpp"), f"move {index + 1} maxpp")
+        if maxpp <= 0 or pp < 0 or pp > maxpp:
+            raise ContractError(f"move {index + 1} pp {pp}/{maxpp} is malformed")
+        disabled = _expect_bool(raw.get("disabled"), f"move {index + 1} disabled flag")
+        legal.append(pp > 0 and not disabled)
+
+    return legal[0], legal[1]
+
+
+# --------------------------------------------------------------------------- #
+# Public decoding
+# --------------------------------------------------------------------------- #
+
+
+def decode(request: Any, profile: Profile) -> Decoded:
+    """Fully validate a request and compute its legality mask.
+
+    Every out-of-scope or malformed feature raises :class:`ContractError`
+    before any mask or command is produced.
+    """
+    request = _expect_mapping(request, "request")
+    for key in _FORBIDDEN_REQUEST_KEYS:
+        if key in request:
+            raise ContractError(f"request key {key!r} is outside the reference scope")
+
+    has_wait = "wait" in request
+    has_force = "forceSwitch" in request
+    has_active = "active" in request
+
+    if has_wait:
+        if request["wait"] is not True:
+            raise ContractError("wait must be exactly true when present")
+        if has_force or has_active:
+            raise ContractError("a wait request cannot carry active or forceSwitch")
+        side_id: Optional[str] = None
+        members: Tuple[Member, ...] = ()
+        if "side" in request:
+            side_id, members = _parse_side(request["side"], profile)
+        return Decoded(kind="wait", side=side_id, members=members, mask=(False, False, False, False))
+
+    side_id, members = _parse_side(request.get("side"), profile)
+    switch_mask = tuple(member.switchable for member in members)
+
+    if has_force:
+        if has_active:
+            raise ContractError("a forceSwitch request cannot carry active")
+        force = _expect_list(request["forceSwitch"], "forceSwitch")
+        if len(force) != 1:
+            raise ContractError(f"singles forceSwitch must have one slot, got {len(force)}")
+        if force[0] is not True:
+            raise ContractError("forceSwitch[0] must be exactly true")
+        if not any(switch_mask):
+            raise ContractError("forceSwitch with no living bench member cannot occur in scope")
+        return Decoded(kind="switch", side=side_id, members=members, mask=(False, False) + switch_mask)
+
+    if not has_active:
+        raise ContractError("request must be a wait, forceSwitch, or move request")
+    active_member = next(member for member in members if member.active)
+    if active_member.fainted:
+        raise ContractError("a move request cannot have a fainted active pokemon")
+    move_mask = _parse_active(request["active"], active_member)
+    return Decoded(kind="move", side=side_id, members=members, mask=move_mask + switch_mask)
+
+
+class Codec:
+    """Four-action codec bound to one admitted profile."""
+
+    def __init__(self, profile: Optional[Profile] = None) -> None:
+        self.profile = profile if profile is not None else load_profile()
+
+    def decode(self, request: Any) -> Decoded:
+        return decode(request, self.profile)
+
+    def mask(self, request: Any) -> Tuple[bool, bool, bool, bool]:
+        return self.decode(request).mask
+
+    def command(self, request: Any, index: Any) -> str:
+        # Validate the whole request first so malformed input is rejected even
+        # when the index would otherwise be legal.
+        decoded = self.decode(request)
+        if type(index) is not int:
+            raise ContractError(f"action index must be an int (not bool), got {index!r}")
+        if not 0 <= index < ACTION_COUNT:
+            raise ContractError(f"action index {index} is outside 0..{ACTION_COUNT - 1}")
+        if not decoded.mask[index]:
+            raise IllegalActionError(
+                f"action {self.profile.actions[index]!r} is not legal for this {decoded.kind} request"
+            )
+        if index < 2:
+            return f"move {index + 1}"
+        member = decoded.member(self.profile.names[index - 2])
+        return f"switch {member.position}"
+
+
+_DEFAULT: Optional[Codec] = None
+
+
+def _default() -> Codec:
+    global _DEFAULT
+    if _DEFAULT is None:
+        _DEFAULT = Codec()
+    return _DEFAULT
+
+
+def mask(request: Any) -> Tuple[bool, bool, bool, bool]:
+    """Legality mask for ``request`` under the repository profile."""
+    return _default().mask(request)
+
+
+def command(request: Any, index: Any) -> str:
+    """Showdown choice string for action ``index`` under the repository profile."""
+    return _default().command(request, index)
