+    def test_profile_parser_rejects_drift(self):
+        import json
+
+        with open(contract.PROFILE_PATH, encoding="utf-8") as handle:
+            raw = json.load(handle)
+        for mutate in (
+            lambda p: p.update(version="other"),
+            lambda p: p.update(team_size=3),
+            lambda p: p.update(names=["A", "C"]),
+            lambda p: p["species"][0]["moves"].append("Growl"),
+            lambda p: p["species"][0].update(id="bulba"),
+        ):
+            bad = copy.deepcopy(raw)
+            mutate(bad)
+            with self.assertRaises(ContractError):
+                contract.parse_profile(bad)
