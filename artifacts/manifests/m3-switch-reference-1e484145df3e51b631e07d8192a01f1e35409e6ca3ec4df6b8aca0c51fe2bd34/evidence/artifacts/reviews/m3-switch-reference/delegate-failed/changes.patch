@@ -0,0 +1,479 @@
+"""Focused unittest for the switch-reference-1 four-action codec.
+
+Run from the repository root with either:
+    python -m unittest tests/switch-reference/test_contract.py
+    python tests/switch-reference/test_contract.py
+"""
+from __future__ import annotations
+
+import copy
+import sys
+import unittest
+from pathlib import Path
+
+_ROOT = Path(__file__).resolve().parents[2]
+_PY = _ROOT / "python"
+if str(_PY) not in sys.path:
+    sys.path.insert(0, str(_PY))
+
+from pokemon_switch import contract  # noqa: E402
+from pokemon_switch.contract import (  # noqa: E402
+    ACTION_COUNT,
+    Codec,
+    ContractError,
+    IllegalActionError,
+    load_profile,
+)
+
+PROFILE = load_profile()
+CODEC = Codec(PROFILE)
+
+# Species -> (display names in declared order) straight from the profile so the
+# fixtures cannot drift from the admitted sets.
+_DISPLAY = {
+    "bulbasaur": ("Vine Whip", "Tackle"),
+    "squirtle": ("Water Gun", "Tackle"),
+    "fennekin": ("Incinerate", "Scratch"),
+}
+
+
+def pokemon(name, species_id, *, side="p1", active=False, condition="105/105", **extra):
+    """A stock-looking side.pokemon entry for original member ``name``."""
+    species = PROFILE.species[species_id]
+    entry = {
+        "ident": f"{side}: {name}",
+        "details": PROFILE.details_for(species_id),
+        "condition": condition,
+        "active": active,
+        "stats": {"atk": 70, "def": 70, "spa": 80, "spd": 80, "spe": 65},
+        "moves": list(species.moves),
+        "baseAbility": "overgrow",
+        "item": "",
+        "pokeball": "pokeball",
+        "ability": "overgrow",
+        "commanding": False,
+        "reviving": False,
+        "teraType": "Grass",
+        "terastallized": "",
+    }
+    entry.update(extra)
+    return entry
+
+
+def active_slot(species_id, pp=(35, 35), disabled=(False, False)):
+    species = PROFILE.species[species_id]
+    moves = []
+    for index, move_id in enumerate(species.moves):
+        moves.append(
+            {
+                "move": _DISPLAY[species_id][index],
+                "id": move_id,
+                "pp": pp[index],
+                "maxpp": 35,
+                "target": "normal",
+                "disabled": disabled[index],
+            }
+        )
+    return {"moves": moves}
+
+
+def move_request(order=("A", "B"), species=("bulbasaur", "squirtle"), active="A", side="p1", **kw):
+    """Singles move request; ``order`` is the current request order of A/B.
+
+    ``species`` is always bound to original names (A, B) so that reordering the
+    request never changes which species A and B are.
+    """
+    by_name = dict(zip(("A", "B"), species))
+    mons = [
+        pokemon(name, by_name[name], side=side, active=(name == active))
+        for name in order
+    ]
+    return {
+        "active": [active_slot(by_name[active], **kw)],
+        "side": {"name": "Max", "id": side, "pokemon": mons},
+        "rqid": 7,
+    }
+
+
+def force_request(order=("A", "B"), species=("bulbasaur", "squirtle"), fainted="A", side="p1"):
+    by_name = dict(zip(("A", "B"), species))
+    mons = [
+        pokemon(
+            name,
+            by_name[name],
+            side=side,
+            active=(name == fainted),
+            condition="0 fnt" if name == fainted else "105/105",
+        )
+        for name in order
+    ]
+    return {
+        "forceSwitch": [True],
+        "side": {"name": "Max", "id": side, "pokemon": mons},
+        "noCancel": True,
+        "rqid": 9,
+    }
+
+
+def wait_request(order=("A", "B"), species=("bulbasaur", "squirtle"), active="A", side="p1"):
+    by_name = dict(zip(("A", "B"), species))
+    mons = [pokemon(name, by_name[name], side=side, active=(name == active)) for name in order]
+    return {"wait": True, "side": {"name": "Max", "id": side, "pokemon": mons}, "rqid": 11}
+
+
+class MaskShapeTest(unittest.TestCase):
+    def test_mask_is_exactly_four_booleans(self):
+        for req in (move_request(), force_request(), wait_request(), {"wait": True}):
+            with self.subTest(kind=list(req)[0]):
+                m = CODEC.mask(req)
+                self.assertIsInstance(m, tuple)
+                self.assertEqual(len(m), ACTION_COUNT)
+                self.assertTrue(all(type(b) is bool for b in m))
+
+    def test_module_level_api_matches_codec(self):
+        req = move_request()
