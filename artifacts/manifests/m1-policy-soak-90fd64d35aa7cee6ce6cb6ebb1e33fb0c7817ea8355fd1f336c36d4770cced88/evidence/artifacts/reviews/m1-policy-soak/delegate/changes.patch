+    try:
+        finite = math.isfinite(value)
+    except OverflowError:
+        # Integers beyond float range cannot be finite in the sense this gate
+        # uses; reject them without rendering the (possibly huge) integer.
+        _fail("%s must be a finite number within floating-point range, got %s"
+              % (name, _describe(value)))
+    if not finite:
         _fail("%s must be finite, got %r" % (name, value))
     return value
 
