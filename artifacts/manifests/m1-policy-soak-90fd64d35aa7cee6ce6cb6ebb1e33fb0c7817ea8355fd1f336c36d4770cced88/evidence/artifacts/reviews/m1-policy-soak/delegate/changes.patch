+def _describe(value):
+    """Render a value for an error message without risking a second failure.
+
+    ``repr`` of an enormous integer can itself raise ``ValueError`` once the
+    interpreter's int-to-str digit limit is exceeded; fall back to a short
+    type-based description rather than rendering the digits.
+    """
+    try:
+        return repr(value)
+    except Exception:
+        return "<%s too large to render>" % type(value).__name__
+
