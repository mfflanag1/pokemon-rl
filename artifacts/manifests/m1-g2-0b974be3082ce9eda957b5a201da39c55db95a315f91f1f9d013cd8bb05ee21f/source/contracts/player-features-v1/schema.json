{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokemon-reference.local/contracts/player-features-v1/schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_kind": {
      "const": "actor_input"
    },
    "feature_version": {
      "const": "r5-player-features-1"
    },
    "layout_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalog_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tensors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "global": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "own": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "array",
            "minItems": 26,
            "maxItems": 26,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "own_public_active": {
          "type": "array",
          "minItems": 27,
          "maxItems": 27,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "opponent_appearances": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "array",
            "minItems": 27,
            "maxItems": 27,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "advertised_moves": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "action_mask": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "type": "boolean"
          }
        },
        "event_bytes": {
          "type": "array",
          "minItems": 64,
          "maxItems": 64,
          "items": {
            "type": "array",
            "minItems": 192,
            "maxItems": 192,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "event_lengths": {
          "type": "array",
          "minItems": 64,
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "event_overflow": {
          "type": "array",
          "minItems": 64,
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "fact_bytes": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "array",
            "minItems": 128,
            "maxItems": 128,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "fact_lengths": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "fact_overflow": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "global",
        "own",
        "own_public_active",
        "opponent_appearances",
        "advertised_moves",
        "actions",
        "action_mask",
        "event_bytes",
        "event_lengths",
        "event_overflow",
        "fact_bytes",
        "fact_lengths",
        "fact_overflow"
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "feature_version",
    "layout_hash",
    "catalog_hash",
    "feature_id",
    "tensors"
  ]
}
